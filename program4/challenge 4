#include <stdio.h>
int main(){
float amount,smallTotal=0,mediumTotal=0,largeTotal=0,total=0,average;
int smallCount=0,mediumCount=0,largeCount=0,count=0;
while(1)
{
printf("Enter expense amount: ");
scanf("%f",&amount);
if(amount==0)
{
break;
else if(amount<0)
{
printf("Invalid expense! Enter a positive amount.\n");
continue;
}
else if(amount<100)
{
smallCount++;
smallTotal+=amount;
}
else if(amount<500)
{
mediumCount++;
mediumTotal+=amount;
}
else
{
largeCount++;
largeTotal+=amount;
}
total+=amount;
count++;
}
printf("EXPENSE SUMMARY\n");
printf("Number of valid expenses: %d\n",count);
printf("Total expenses: Rs. %.2f\n",total);
printf("\nSmall expenses: %d\n",smallCount);
printf("Small total: Rs. %.2f\n",smallTotal);
printf("\nMedium expenses: %d\n",mediumCount);
printf("Medium total: Rs. %.2f\n",mediumTotal);
printf("\nLarge expenses: %d\n",largeCount);
printf("Large total: Rs. %.2f\n",largeTotal);
if(count>0)
{
average=total/count;
printf("\nAverage expense: Rs. %.2f\n",average);
}
else
{
printf("\nNo valid expenses entered.\n");
}
return 0;
}
