#include<stdio.h>
#define ZONES 5
#define DAYS 7
const char *getZone(int i)
{
switch(i)
{
case 0:return "Academic Block";
case 1:return "Hostel";
case 2:return "Library";
case 3:return "Cafeteria";
default:return "Sports Area";
}
}
void inputData(float temp[ZONES][DAYS],float humidity[ZONES][DAYS],int aqi[ZONES][DAYS])
{
int i,j;
for(i=0;i<ZONES;i++)
{
printf("\nEnter data for %s\n",getZone(i));
for(j=0;j<DAYS;j++)
{
printf("Day %d Temperature: ",j+1);
scanf("%f",&temp[i][j]);
while(temp[i][j]<10||temp[i][j]>50)
{
printf("Invalid! Enter temperature between 10 and 50: ");
scanf("%f",&temp[i][j]);
}
printf("Humidity: ");
scanf("%f",&humidity[i][j]);
while(humidity[i][j]<0||humidity[i][j]>100)
{
printf("Invalid! Enter humidity between 0 and 100: ");
scanf("%f",&humidity[i][j]);
}
printf("AQI: ");
scanf("%d",&aqi[i][j]);
while(aqi[i][j]<0||aqi[i][j]>500)
{
printf("Invalid! Enter AQI between 0 and 500: ");
scanf("%d",&aqi[i][j]);
}
}
}
}
void displayData(float temp[ZONES][DAYS],float humidity[ZONES][DAYS],int aqi[ZONES][DAYS])
{
int i,j;
printf("\nTEMPERATURE DATA\n");
for(i=0;i<ZONES;i++)
{
printf("\n%s: ",getZone(i));
for(j=0;j<DAYS;j++)
printf("%.1f ",temp[i][j]);
}
printf("\n\nHUMIDITY DATA\n");
for(i=0;i<ZONES;i++)
{
printf("\n%s: ",getZone(i));
for(j=0;j<DAYS;j++)
printf("%.1f ",humidity[i][j]);
}
printf("\n\nAQI DATA\n");
for(i=0;i<ZONES;i++)
{
printf("\n%s: ",getZone(i));
for(j=0;j<DAYS;j++)
printf("%d ",aqi[i][j]);
}
printf("\n");
}
void calculateAverages(float temp[ZONES][DAYS],float humidity[ZONES][DAYS],int aqi[ZONES][DAYS],float avgTemp[ZONES],float avgHumidity[ZONES],float avgAQI[ZONES])
{
int i,j;
for(i=0;i<ZONES;i++)
{
avgTemp[i]=0;
avgHumidity[i]=0;
avgAQI[i]=0;
for(j=0;j<DAYS;j++)
{
avgTemp[i]+=temp[i][j];
avgHumidity[i]+=humidity[i][j];
avgAQI[i]+=aqi[i][j];
}
avgTemp[i]/=DAYS;
avgHumidity[i]/=DAYS;
avgAQI[i]/=DAYS;
}
printf("\nZONE WISE AVERAGES\n");
for(i=0;i<ZONES;i++)
printf("%s: Temp=%.2f Humidity=%.2f AQI=%.2f\n",getZone(i),avgTemp[i],avgHumidity[i],avgAQI[i]);
}
void detectRiskZones(float temp[ZONES][DAYS],float humidity[ZONES][DAYS],int aqi[ZONES][DAYS],int riskDays[ZONES])
{
int i,j;
for(i=0;i<ZONES;i++)
{
riskDays[i]=0;
for(j=0;j<DAYS;j++)
{
if(aqi[i][j]>150||temp[i][j]>35||humidity[i][j]>80)
riskDays[i]++;
}
}
printf("\nRISK DAY REPORT\n");
for(i=0;i<ZONES;i++)
printf("%s: %d risk days\n",getZone(i),riskDays[i]);
}
void computeGreenIndex(float avgTemp[ZONES],float avgHumidity[ZONES],float avgAQI[ZONES],float greenIndex[ZONES])
{
int i;
float aqiScore,tempScore,humidityScore,d;
for(i=0;i<ZONES;i++)
{
aqiScore=100-(avgAQI[i]/5);
if(avgTemp[i]>25)
d=avgTemp[i]-25;
else
d=25-avgTemp[i];
tempScore=100-(4*d);
if(avgHumidity[i]>50)
d=avgHumidity[i]-50;
else
d=50-avgHumidity[i];
humidityScore=100-(2*d);
if(aqiScore<0)
aqiScore=0;
if(tempScore<0)
tempScore=0;
if(humidityScore<0)
humidityScore=0;
greenIndex[i]=(0.4*aqiScore)+(0.3*tempScore)+(0.3*humidityScore);
}
}
void displayRanking(float greenIndex[ZONES])
{
int i,j,rank,index[ZONES],temp;
for(i=0;i<ZONES;i++)
index[i]=i;
for(i=0;i<ZONES-1;i++)
{
for(j=i+1;j<ZONES;j++)
{
if(greenIndex[index[i]]<greenIndex[index[j]])
{
temp=index[i];
index[i]=index[j];
index[j]=temp;
}
}
}
printf("\nGREEN INDEX RANKING\n");
for(i=0;i<ZONES;i++)
{
rank=1;
for(j=0;j<ZONES;j++)
{
if(greenIndex[j]>greenIndex[index[i]])
rank++;
}
printf("Rank %d - %s : %.2f\n",rank,getZone(index[i]),greenIndex[index[i]]);
}
}
void displayRecommendations(float avgTemp[ZONES],float avgHumidity[ZONES],float avgAQI[ZONES],int riskDays[ZONES])
{
int i,flag;
printf("\nENVIRONMENTAL RECOMMENDATIONS\n");
for(i=0;i<ZONES;i++)
{
flag=0;
printf("\n%s:\n",getZone(i));
if(avgAQI[i]>150)
{
printf("- Reduce vehicle idling and improve ventilation.\n");
flag=1;
}
if(avgTemp[i]>35)
{
printf("- Provide shade and increase green cover.\n");
flag=1;
}
if(avgHumidity[i]>80)
{
printf("- Check ventilation and stagnant water sources.\n");
flag=1;
}
if(flag==0&&riskDays[i]>0)
printf("- Review the individual days when risk was detected.\n");
if(riskDays[i]==0)
printf("- No risk detected. Continue monitoring.\n");
}
}
int main()
{
float temp[ZONES][DAYS],humidity[ZONES][DAYS];
int aqi[ZONES][DAYS];
float avgTemp[ZONES],avgHumidity[ZONES],avgAQI[ZONES];
float greenIndex[ZONES];
int riskDays[ZONES];
int choice,dataReady=0;
do
{
printf("\n===== CAMPUS ENVIRONMENT MONITORING =====\n");
printf("1. Input/Update Data\n");
printf("2. Display Data\n");
printf("3. Zone-wise Averages\n");
printf("4. Detect Risk Days\n");
printf("5. Green Index and Ranking\n");
printf("6. Recommendations\n");
printf("7. Exit\n");
printf("Enter your choice: ");
scanf("%d",&choice);
switch(choice)
{
case 1:
inputData(temp,humidity,aqi);
dataReady=1;
break;
case 2:
if(dataReady)
displayData(temp,humidity,aqi);
else
printf("Please enter data first!\n");
break;
case 3:
if(dataReady)
calculateAverages(temp,humidity,aqi,avgTemp,avgHumidity,avgAQI);
else
printf("Please enter data first!\n");
break;
case 4:
if(dataReady)
detectRiskZones(temp,humidity,aqi,riskDays);
else
printf("Please enter data first!\n");
break;
case 5:
if(dataReady)
{
calculateAverages(temp,humidity,aqi,avgTemp,avgHumidity,avgAQI);
detectRiskZones(temp,humidity,aqi,riskDays);
computeGreenIndex(avgTemp,avgHumidity,avgAQI,greenIndex);
displayRanking(greenIndex);
}
else
printf("Please enter data first!\n");
break;
case 6:
if(dataReady)
{
calculateAverages(temp,humidity,aqi,avgTemp,avgHumidity,avgAQI);
detectRiskZones(temp,humidity,aqi,riskDays);
displayRecommendations(avgTemp,avgHumidity,avgAQI,riskDays);
}
else
printf("Please enter data first!\n");
break;
case 7:
printf("Exiting program. Thank you!\n");
break;
default:
printf("Invalid choice! Try again.\n");
}
}
while(choice!=7);
return 0;
}
