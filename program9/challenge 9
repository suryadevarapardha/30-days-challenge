#include<stdio.h>
#define ROWS 5
#define COLS 8
void initializeSeats(int seats[ROWS][COLS]);
void displaySeats(int seats[ROWS][COLS]);
int bookSeat(int seats[ROWS][COLS],int row,int col);
int cancelSeat(int seats[ROWS][COLS],int row,int col);
int reserveGroup(int seats[ROWS][COLS],int groupSize);
void displayReport(int seats[ROWS][COLS]);
int main()
{
int seats[ROWS][COLS],choice,row,col,groupSize;
initializeSeats(seats);
do
{
printf("\n1. display seats\n");
printf("2. book one seat\n");
printf("3. cancel booking\n");
printf("4. group reservation\n");
printf("5. occupancy report\n");
printf("6. exit\n");
printf("enter your choice: ");
scanf("%d",&choice);
switch(choice)
{
case 1:
displaySeats(seats);
break;
case 2:
printf("enter row and seat number: ");
scanf("%d%d",&row,&col);
if(bookSeat(seats,row,col))
printf("seat booked successfully\n");
else
printf("seat booking failed\n");
displaySeats(seats);
break;
case 3:
printf("enter row and seat number: ");
scanf("%d%d",&row,&col);
if(cancelSeat(seats,row,col))
printf("booking cancelled successfully\n");
else
printf("cancellation failed\n");
displaySeats(seats);
break;
case 4:
printf("enter group size: ");
scanf("%d",&groupSize);
if(reserveGroup(seats,groupSize))
{
printf("group reservation successful\n");
displaySeats(seats);
}
else
printf("group reservation failed\n");
break;
case 5:
displayReport(seats);
break;
case 6:
printf("thank you\n");
break;
default:
printf("invalid choice\n");
}
}while(choice!=6);
return 0;
}
void initializeSeats(int seats[ROWS][COLS])
{
int i,j;
for(i=0;i<ROWS;i++)
{
for(j=0;j<COLS;j++)
seats[i][j]=0;
}
}
void displaySeats(int seats[ROWS][COLS])
{
int i,j;
printf("\n0 = available, 1 = booked\n");
printf("     ");
for(j=0;j<COLS;j++)
printf("%d ",j+1);
printf("\n");
for(i=0;i<ROWS;i++)
{
printf("row %d: ",i+1);
for(j=0;j<COLS;j++)
printf("%d ",seats[i][j]);
printf("\n");
}
}
int bookSeat(int seats[ROWS][COLS],int row,int col)
{
if(row<1||row>ROWS||col<1||col>COLS)
return 0;
if(seats[row-1][col-1]==1)
return 0;
seats[row-1][col-1]=1;
return 1;
}
int cancelSeat(int seats[ROWS][COLS],int row,int col)
{
if(row<1||row>ROWS||col<1||col>COLS)
return 0;
if(seats[row-1][col-1]==0)
return 0;
seats[row-1][col-1]=0;
return 1;
}
int reserveGroup(int seats[ROWS][COLS],int groupSize)
{
int i,j,k,flag;
if(groupSize<2||groupSize>8)
return 0;
for(i=0;i<ROWS;i++)
{
for(j=0;j<=COLS-groupSize;j++)
{
flag=1;
for(k=0;k<groupSize;k++)
{
if(seats[i][j+k]==1)
{
flag=0;
break;
}
}
if(flag==1)
{
for(k=0;k<groupSize;k++)
seats[i][j+k]=1;
printf("group booked in row %d from seat %d to seat %d\n",i+1,j+1,j+groupSize);
return 1;
}
}
}
return 0;
}
void displayReport(int seats[ROWS][COLS])
{
int i,j,booked=0,available=0,count[ROWS]={0},max=0;
float percentage;
for(i=0;i<ROWS;i++)
{
for(j=0;j<COLS;j++)
{
if(seats[i][j]==1)
{
booked++;
count[i]++;
}
else
available++;
}
}
percentage=(booked*100.0)/(ROWS*COLS);
for(i=0;i<ROWS;i++)
{
if(count[i]>max)
max=count[i];
}
printf("\ntotal seats: %d\n",ROWS*COLS);
printf("booked seats: %d\n",booked);
printf("available seats: %d\n",available);
printf("occupancy percentage: %.2f%%\n",percentage);
printf("busiest row: ");
if(max==0)
printf("no bookings");
else
{
for(i=0;i<ROWS;i++)
{
if(count[i]==max)
printf("%d ",i+1);
}
}
printf("\n");
}




