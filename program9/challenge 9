#include<stdio.h>
#define ROWS 5
#define COLS 8
void initializeSeats(int a[ROWS][COLS])
{
int i,j;
for(i=0;i<ROWS;i++)
{
for(j=0;j<COLS;j++)
{
a[i][j]=0;
}
}
}
void displaySeats(int a[ROWS][COLS])
{
int i,j;
printf("0-Available 1-Booked\n");
for(i=0;i<ROWS;i++)
{
printf("Row %d: ",i+1);
for(j=0;j<COLS;j++)
{
printf("%d ",a[i][j]);
}
printf("\n");
}
}
int bookSeat(int a[ROWS][COLS],int r,int c)
{
if(r>=1&&r<=5&&c>=1&&c<=8)
{
if(a[r-1][c-1]==0)
{
a[r-1][c-1]=1;
return 1;
}
}
return 0;
}
int cancelSeat(int a[ROWS][COLS],int r,int c)
{
if(r>=1&&r<=5&&c>=1&&c<=8)
{
if(a[r-1][c-1]==1)
{
a[r-1][c-1]=0;
return 1;
}
}
return 0;
}
int reserveGroup(int a[ROWS][COLS],int n)
{
int i,j,k,count;
if(n<2||n>8)
return 0;
for(i=0;i<ROWS;i++)
{
for(j=0;j<=COLS-n;j++)
{
count=0;
for(k=0;k<n;k++)
{
if(a[i][j+k]==0)
count++;
}
if(count==n)
{
for(k=0;k<n;k++)
a[i][j+k]=1;
printf("Row: %d\n",i+1);
printf("Seats: ");
for(k=0;k<n;k++)
printf("%d ",j+k+1);
printf("\n");
return 1;
}
}
}
return 0;
}
void displayReport(int a[ROWS][COLS])
{
int i,j,booked=0,max=0;
int row[ROWS]={0};
for(i=0;i<ROWS;i++)
{
for(j=0;j<COLS;j++)
{
if(a[i][j]==1)
{
booked++;
row[i]++;
}
}
}
printf("\nTotal seats: 40\n");
printf("Booked seats: %d\n",booked);
printf("Available seats: %d\n",40-booked);
printf("Occupancy percentage: %.2f%%\n",booked*100.0/40);
for(i=0;i<ROWS;i++)
{
if(row[i]>max)
max=row[i];
}
printf("Highest booked seats: %d\n",max);
printf("Rows with highest bookings: ");
for(i=0;i<ROWS;i++)
{
if(row[i]==max)
printf("%d ",i+1);
}
printf("\n");
}
int main()
{
int seats[ROWS][COLS];
int choice,r,c,n;
initializeSeats(seats);
do
{
printf("1.Display Seats\n");
printf("2.Book Seat\n");
printf("3.Cancel Booking\n");
printf("4.Group Reservation\n");
printf("5.Occupancy Report\n");
printf("6.Exit\n");
printf("Enter your choice: ");
scanf("%d",&choice);
switch(choice)
{
case 1:
displaySeats(seats);
break;
case 2:
printf("Enter row and seat number: ");
scanf("%d %d",&r,&c);
if(bookSeat(seats,r,c))
printf("Booking successful\n");
else
printf("Seat unavailable or invalid input\n");
displaySeats(seats);
break;
case 3:
printf("Enter row and seat number: ");
scanf("%d %d",&r,&c);
if(cancelSeat(seats,r,c))
printf("Cancellation successful\n");
else
printf("Invalid seat or seat is not booked\n");
displaySeats(seats);
break;
case 4:
printf("Enter group size (2-8): ");
scanf("%d",&n);
if(reserveGroup(seats,n))
printf("Group booking successful\n");
else
printf("No suitable consecutive seats found\n");
displaySeats(seats);
break;
case 5:
displayReport(seats);
break;
case 6:
printf("Program terminated\n");
break;
default:
printf("Invalid choice\n");
}
}while(choice!=6);
return 0;
}
