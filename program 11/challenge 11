#include <stdio.h>
#define ZONES 5
#define DAYS 7
const char *getZone(int i)
{
if(i==0)return "Academic Block";
if(i==1)return "Hostel";
if(i==2)return "Library";
if(i==3)return "Cafeteria";
return "Sports Complex";
}
void inputWaterData(int usage[ZONES][DAYS],int dailyTarget[ZONES])
{
int i,j;
for(i=0;i<ZONES;i++)
{
printf("\nEnter target for %s: ",getZone(i));
scanf("%d",&dailyTarget[i]);
while(dailyTarget[i]<100||dailyTarget[i]>50000)
{
printf("Invalid target. Enter again: ");
scanf("%d",&dailyTarget[i]);
}
printf("Enter 7 days water readings:\n");
for(j=0;j<DAYS;j++)
{
printf("Day %d: ",j+1);
scanf("%d",&usage[i][j]);
while(usage[i][j]<0||usage[i][j]>50000)
{
printf("Invalid reading. Enter again: ");
scanf("%d",&usage[i][j]);
}
}
}
}
void displayWaterData(int usage[ZONES][DAYS],int dailyTarget[ZONES])
{
int i,j;
printf("\nWATER CONSUMPTION DETAILS\n");
for(i=0;i<ZONES;i++)
{
printf("\n%s (Target: %d)\n",getZone(i),dailyTarget[i]);
for(j=0;j<DAYS;j++)
printf("Day %d = %d Litres\n",j+1,usage[i][j]);
}
}
void calculateZoneStats(int *zoneUsage,int *total,float *average,int *peakUsage,int *peakDay)
{
int i;
*total=0;
*peakUsage=*zoneUsage;
*peakDay=1;
for(i=0;i<DAYS;i++)
{
*total=*total+*(zoneUsage+i);
if(*(zoneUsage+i)>*peakUsage)
{
*peakUsage=*(zoneUsage+i);
*peakDay=i+1;
}
}
*average=(float)*total/DAYS;
}
void detectWaterAlerts(int *zoneUsage,int dailyTarget,int *overLimitDays,int *totalExcess,int *spikeDays,int *alertDays)
{
int i,over,spike;
*overLimitDays=0;
*totalExcess=0;
*spikeDays=0;
*alertDays=0;
for(i=0;i<DAYS;i++)
{
over=0;
spike=0;
if(*(zoneUsage+i)>dailyTarget)
{
over=1;
(*overLimitDays)++;
*totalExcess+=*(zoneUsage+i)-dailyTarget;
}
if(i>0&&(*(zoneUsage+i)*100>*(zoneUsage+i-1)*140))
{
spike=1;
(*spikeDays)++;
}
if(over==1||spike==1)
(*alertDays)++;
}
}
void generateAuditReport(int usage[ZONES][DAYS],int dailyTarget[ZONES],int excessByZone[ZONES],int overLimitByZone[ZONES],int spikeByZone[ZONES],int alertByZone[ZONES])
{
int i,total,peak,day;
float average;
printf("\nWATER AUDIT REPORT\n");
for(i=0;i<ZONES;i++)
{
calculateZoneStats(&usage[i][0],&total,&average,&peak,&day);
detectWaterAlerts(&usage[i][0],dailyTarget[i],&overLimitByZone[i],&excessByZone[i],&spikeByZone[i],&alertByZone[i]);
printf("\nZone: %s\n",getZone(i));
printf("Weekly Total: %d\n",total);
printf("Daily Average: %.2f\n",average);
printf("Highest Usage: %d\n",peak);
printf("Peak Day: Day %d\n",day);
printf("Over Limit Days: %d\n",overLimitByZone[i]);
printf("Total Excess: %d\n",excessByZone[i]);
printf("Spike Days: %d\n",spikeByZone[i]);
printf("Unique Alert Days: %d\n",alertByZone[i]);
}
}
void rankZones(int excessByZone[ZONES])
{
int i,j,rank;
printf("\nZONE RANKING\n");
for(i=0;i<ZONES;i++)
{
rank=1;
for(j=0;j<ZONES;j++)
{
if(excessByZone[j]>excessByZone[i])
rank++;
}
printf("%s : Rank %d (Excess %d Litres)\n",getZone(i),rank,excessByZone[i]);
}
}
void displayConservationActions(int overLimitByZone[ZONES],int spikeByZone[ZONES],int excessByZone[ZONES])
{
int i;
printf("\nCONSERVATION ACTIONS\n");
for(i=0;i<ZONES;i++)
{
printf("\n%s\n",getZone(i));
if(spikeByZone[i]>0)
printf("Check for leaks or unexpected water usage.\n");
if(overLimitByZone[i]>=3)
printf("Prioritise a water audit and prepare a reduction plan.\n");
else if(overLimitByZone[i]>0)
printf("Monitor usage and inspect taps or valves.\n");
if(overLimitByZone[i]==0&&spikeByZone[i]==0)
printf("Maintain current water-saving practices.\n");
printf("Total Excess: %d Litres\n",excessByZone[i]);
}
}
int main()
{
int usage[ZONES][DAYS];
int dailyTarget[ZONES];
int excessByZone[ZONES]={0};
int overLimitByZone[ZONES]={0};
int spikeByZone[ZONES]={0};
int alertByZone[ZONES]={0};
int choice,i,entered=0;
do
{
printf("\n===== WATERWISE MENU =====\n");
printf("1. Enter Water Readings\n");
printf("2. Display Water Readings\n");
printf("3. Water Audit Report\n");
printf("4. Zone Ranking\n");
printf("5. Conservation Actions\n");
printf("6. Complete Report\n");
printf("0. Exit\n");
printf("Enter your choice: ");
scanf("%d",&choice);
switch(choice)
{
case 1:
inputWaterData(usage,dailyTarget);
entered=1;
break;
case 2:
if(entered)
displayWaterData(usage,dailyTarget);
else
printf("Enter data first.\n");
break;
case 3:
if(entered)
generateAuditReport(usage,dailyTarget,excessByZone,overLimitByZone,spikeByZone,alertByZone);
else
printf("Enter data first.\n");
break;
case 4:
if(entered)
{
generateAuditReport(usage,dailyTarget,excessByZone,overLimitByZone,spikeByZone,alertByZone);
rankZones(excessByZone);
}
else
printf("Enter data first.\n");
break;
case 5:
if(entered)
{
generateAuditReport(usage,dailyTarget,excessByZone,overLimitByZone,spikeByZone,alertByZone);
displayConservationActions(overLimitByZone,spikeByZone,excessByZone);
}
else
printf("Enter data first.\n");
break;
case 6:
if(entered)
{
displayWaterData(usage,dailyTarget);
generateAuditReport(usage,dailyTarget,excessByZone,overLimitByZone,spikeByZone,alertByZone);
rankZones(excessByZone);
displayConservationActions(overLimitByZone,spikeByZone,excessByZone);
}
else
printf("Enter data first.\n");
break;
case 0:
printf("Thank you for using WATERWISE.\n");
break;
default:
printf("Invalid choice. Try again.\n");
}
}
while(choice!=0);
return 0;
}
